# Salin ke .env. Semua nilai di bawah palsu, ganti untuk lingkungan nyata.
# Pakai 127.0.0.1, bukan localhost: di Windows localhost mencoba IPv6 dulu, sedangkan Compose hanya membuka IPv4.
# Untuk `prisma migrate dev` lokal, pakai user root (butuh hak membuat shadow database).
DATABASE_URL=mysql://root:root@127.0.0.1:3306/starter
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7
PORT=3000
# true = seed akun demo saat container start (hanya untuk demo lokal)
SEED_DEMO=false
